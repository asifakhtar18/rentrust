# Copy to .env.local for local development with the NestJS API.
# In Vercel, set the rentrust-api deployment URL followed by /api/v1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Must match BFF_PROXY_SECRET in the API project's environment variables.
# Keep this server-only; do not add the NEXT_PUBLIC_ prefix.
BFF_PROXY_SECRET=replace-with-a-distinct-random-secret-at-least-32-characters

# Browser-restricted Ola Maps key; set its allowed site origins in the Ola console.
NEXT_PUBLIC_OLA_MAPS_API_KEY=
