# ---------------------------------------------------------------------------
# RenTrust environment template. Copy to `.env` and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=api
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Public base URL of the web app, used to build links in emails.
# Defaults to the first CORS origin (then localhost:3000) if unset.
APP_URL=http://localhost:3000

# Database (PostgreSQL + PostGIS). docker-compose provisions these credentials.
DATABASE_URL=postgresql://rentrust:rentrust@localhost:5432/rentrust?schema=public
# Vercel's Supabase integration supplies these in its project environments.
# POSTGRES_PRISMA_URL=<pooled Supabase URL used by the API>
# POSTGRES_URL_NON_POOLING=<direct Supabase URL used for migrations>

# Redis (cache, rate limit, BullMQ)
REDIS_URL=redis://localhost:6379
# Vercel functions run trust-score recalculation inline; long-lived Node hosts use BullMQ.
# TRUST_SCORE_QUEUE_DRIVER=inline

# JWT — generate strong secrets for production (e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

# Object storage for verification/claim documents (Cloudflare R2 S3 API).
# Mock storage is for local development only; production requires R2.
STORAGE_DRIVER=mock
# --- Cloudflare R2 ---
# Set STORAGE_DRIVER=s3 to enable these values.
# STORAGE_DRIVER=s3
# STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_BUCKET=rentrust-documents
# STORAGE_ACCESS_KEY_ID=<access key id>
# STORAGE_SECRET_ACCESS_KEY=<secret access key>
# STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL=900

# Email.
#   driver=console  -> prints emails to the log (local dev / tests; no SMTP needed)
#   driver=smtp      -> sends real email via the SMTP settings below (staging/prod)
EMAIL_DRIVER=console
EMAIL_FROM=RentTrust <no-reply@rentrust.local>
# Required when EMAIL_DRIVER=smtp:
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); defaults to true only when SMTP_PORT=465.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Trust score
TRUST_SCORE_MIN_REVIEWS=30

# Rate limiting (requests per window)
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Frontend (apps/web)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Browser-restricted Ola Maps key; set its allowed site origins in the Ola console.
OLA_MAP_API_KEY=
