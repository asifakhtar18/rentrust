# ---------------------------------------------------------------------------
# RentTrust environment template. Copy to `.env` and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=api
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL + PostGIS). docker-compose provisions these credentials.
DATABASE_URL=postgresql://rentrust:rentrust@localhost:5432/rentrust?schema=public

# Redis (cache, rate limit, BullMQ)
REDIS_URL=redis://localhost:6379

# JWT — generate strong secrets for production (e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

# Object storage for verification/claim documents (S3-compatible).
# driver=mock keeps everything local for development.
# driver=s3 works with AWS S3, Cloudflare R2, or MinIO.
STORAGE_DRIVER=mock
# --- Cloudflare R2 (production) ---
#   STORAGE_DRIVER=s3
#   STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   STORAGE_REGION=auto
#   STORAGE_BUCKET=rentrust-documents
#   STORAGE_ACCESS_KEY_ID=<R2 access key id>
#   STORAGE_SECRET_ACCESS_KEY=<R2 secret access key>
#   STORAGE_FORCE_PATH_STYLE=true
# --- Local MinIO ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=rentrust-documents
STORAGE_ACCESS_KEY_ID=rentrust
STORAGE_SECRET_ACCESS_KEY=rentrust-secret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL=900

# Image compression (applied server-side before storage; strips EXIF metadata)
IMAGE_COMPRESSION_ENABLED=true
IMAGE_MAX_WIDTH=2000
IMAGE_MAX_HEIGHT=2000
IMAGE_QUALITY=80

# Email — driver=console prints emails to the log in development.
EMAIL_DRIVER=console
EMAIL_FROM=RentTrust <no-reply@rentrust.local>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Trust score
TRUST_SCORE_MIN_REVIEWS=30

# Rate limiting (requests per window)
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Frontend (apps/web)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
